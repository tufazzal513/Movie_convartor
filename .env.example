# Existing Telegram bot token (BotFather)
TELOXIDE_TOKEN=

# Telegram application credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API executable uploaded to the BotKeep root
LOCAL_BOT_API_BIN=./telegram-bot-api
LOCAL_BOT_API_PORT=8081

# Persistent Local Bot API cache/session data
TELEGRAM_LOCAL_FILES_DIR=./data/local-bot-api
LOCAL_BOT_API_TEMP_DIR=./data/local-bot-api/tmp

# Disk-backed conversion workspace, not RAM-backed /tmp
TMPDIR=./data/jobs

# Maximum input and output size: 400 MiB each.
# Ensure the host has enough temporary disk space for source + output + Telegram cache.
MAX_INPUT_BYTES=419430400
MAX_OUTPUT_BYTES=419430400

USER_DAILY_LIMIT=10
GLOBAL_DAILY_LIMIT=50
RUST_LOG=info
